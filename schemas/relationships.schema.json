{
  "$defs": {
    "bbox": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    },
    "geometry": {
      "additionalProperties": true,
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/bbox"
            },
            {
              "type": "null"
            }
          ]
        },
        "center": {
          "$ref": "#/$defs/point"
        },
        "coordinates": {},
        "focusPoint": {
          "$ref": "#/$defs/point"
        },
        "normalizedCenter": {
          "$ref": "#/$defs/point"
        },
        "type": {
          "enum": [
            "Polygon",
            "Point"
          ]
        },
        "validated": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "bbox",
        "center",
        "focusPoint",
        "normalizedCenter",
        "validated"
      ],
      "type": "object"
    },
    "point": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "const": "pdf-map"
        }
      },
      "required": [
        "type",
        "file",
        "page"
      ],
      "type": "object"
    },
    "validation": {
      "additionalProperties": true,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "validated",
            "needs-review",
            "unresolved",
            "not-applicable"
          ]
        }
      },
      "required": [
        "status",
        "confidence",
        "notes"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "generatedAt": {
      "type": "string"
    },
    "pointOfInterestCategories": {
      "items": {
        "required": [
          "pointOfInterestId",
          "categoryId"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "standCategories": {
      "items": {
        "required": [
          "standId",
          "categoryId"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "standExhibitors": {
      "items": {
        "required": [
          "standId",
          "exhibitorId"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "standStreets": {
      "items": {
        "required": [
          "standId",
          "streetId"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "source",
    "standExhibitors",
    "standCategories",
    "standStreets",
    "pointOfInterestCategories"
  ],
  "type": "object"
}