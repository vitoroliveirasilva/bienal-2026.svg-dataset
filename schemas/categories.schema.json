{
  "$defs": {
    "bbox": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    },
    "geometry": {
      "additionalProperties": true,
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/bbox"
            },
            {
              "type": "null"
            }
          ]
        },
        "center": {
          "$ref": "#/$defs/point"
        },
        "coordinates": {},
        "focusPoint": {
          "$ref": "#/$defs/point"
        },
        "normalizedCenter": {
          "$ref": "#/$defs/point"
        },
        "type": {
          "enum": [
            "Polygon",
            "Point"
          ]
        },
        "validated": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "bbox",
        "center",
        "focusPoint",
        "normalizedCenter",
        "validated"
      ],
      "type": "object"
    },
    "point": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "const": "pdf-map"
        }
      },
      "required": [
        "type",
        "file",
        "page"
      ],
      "type": "object"
    },
    "validation": {
      "additionalProperties": true,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "validated",
            "needs-review",
            "unresolved",
            "not-applicable"
          ]
        }
      },
      "required": [
        "status",
        "confidence",
        "notes"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "categories": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "fillType": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "legendOrder": {
            "type": "integer"
          },
          "normalizedName": {
            "type": "string"
          },
          "originalColor": {
            "type": "object"
          },
          "originalName": {
            "type": "string"
          },
          "relatedElementIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "strokeType": {
            "type": "string"
          },
          "visualRepresentation": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "originalName",
          "normalizedName",
          "description",
          "originalColor",
          "fillType",
          "strokeType",
          "visualRepresentation",
          "legendOrder",
          "relatedElementIds",
          "source"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "generatedAt": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/source"
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "source",
    "categories"
  ],
  "type": "object"
}